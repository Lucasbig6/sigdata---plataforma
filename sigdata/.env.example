# Banco de desenvolvimento (sobe com: docker compose up -d)
DATABASE_URL=postgres://sigdata:sigdata@localhost:5434/sigdata

# Autenticação (Better Auth)
# gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Criptografia das credenciais de conexões externas (32 bytes em base64)
# gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SIGDATA_ENCRYPTION_KEY=

# Pasta onde ficam arquivos enviados e bancos DuckDB das fontes (default: ./storage)
# SIGDATA_STORAGE_DIR=./storage

GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# modelo Groq opcional (default: qwen/qwen3.8-27b)
# GROQ_MODEL=qwen/qwen3.8-27b

# teto de tokens de saída por requisição (OTPM do plano é 1000/min; default: 900)
# GROQ_MAX_OUTPUT_TOKENS=900
