PORT=4000

# Banco (na raiz: npm run db:up)
DATABASE_URL=postgres://sigdata:sigdata@localhost:5434/sigdata

# Autenticação (Better Auth). BETTER_AUTH_URL = URL pública do FRONTEND.
# gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# origens extras aceitas (separadas por vírgula), opcional
# TRUSTED_ORIGINS=

# Criptografia das credenciais de conexões externas (32 bytes em base64)
# gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SIGDATA_ENCRYPTION_KEY=

# Pasta dos arquivos enviados e bancos DuckDB das fontes (default: ./storage)
# SIGDATA_STORAGE_DIR=./storage

# Provedor do chat: "anthropic" (Claude), "groq", "openrouter" ou "openai-compatible".
# Sem AI_PROVIDER, usa Claude se houver ANTHROPIC_API_KEY.
# AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Modelo do Claude (padrão claude-opus-5-5). Mais barato: claude-sonnet-5-5 ou claude-haiku-5-5.
# ANTHROPIC_MODEL=claude-opus-5-5
# Limite de tokens por resposta (inclui o raciocínio do modelo). Padrão 8192 no Claude.
# CHAT_MAX_OUTPUT_TOKENS=8192

GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_MAX_OUTPUT_TOKENS=900

# Conexões com bancos externos: em produção, hosts de rede interna (localhost, 10.x, 192.168.x…)
# são recusados. Defina true só se for necessário (padrão: liberado fora de produção).
# SIGDATA_ALLOW_PRIVATE_HOSTS=false
# Cadastro aberto: qualquer pessoa cria conta (padrão: aberto fora de produção, fechado em produção).
# Fechado, só o admin cria contas em Usuários. A primeira conta do sistema sempre pode ser criada.
# SIGDATA_OPEN_SIGNUP=false
# Fonte e dashboards de demonstração em contas novas (padrão: ligado fora de produção, desligado em produção).
# SIGDATA_SEED_DEMO=false
# Limite de mensagens do chat por usuário por minuto
# CHAT_RATE_LIMIT_PER_MIN=20

# E-mails (recuperação de senha). Sem RESEND_API_KEY o link aparece só no log do servidor.
# RESEND_API_KEY=
# MAIL_FROM="SIGDATA <no-reply@seudominio.com>"

# OpenRouter (AI_PROVIDER=openrouter): https://openrouter.ai/keys
# Escolha um modelo que aceite ferramentas ("tools") em https://openrouter.ai/models (filtro "free" para os gratuitos).
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=provedor/modelo:free

# Qualquer API no formato OpenAI (AI_PROVIDER=openai-compatible): Gemini, Cerebras, Mistral, Ollama local...
# Ollama: AI_BASE_URL=http://localhost:11434/v1  e  AI_MODEL=qwen2.5:14b (sem chave)
# Gemini: AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  (chave do AI Studio em AI_API_KEY)
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=
# AI_MAX_OUTPUT_TOKENS=4096
